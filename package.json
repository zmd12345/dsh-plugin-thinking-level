{
  "name": "dsh-plugin-thinking-level",
  "version": "0.4.5",
  "description": "根据当前任务和最近几轮对话在本地判断合适的推理等级，一键切换；会话过长时按当前上下文占用提醒，并区分「换个话题」和「同一件事没做完」给出不同建议：简单任务不过度思考、节省 token，复杂任务给足推理。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "docs",
    "screenshots.json",
    "scripts/check-compaction.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/client.test.mjs && node test/context.test.mjs && node test/scale.test.mjs && node test/session.test.mjs",
    "check:compaction": "node scripts/check-compaction.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "thinking-level",
    "token-saving",
    "productivity"
  ],
  "homepage": "https://github.com/zmd12345/dsh-plugin-thinking-level",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmd12345/dsh-plugin-thinking-level.git"
  }
}
